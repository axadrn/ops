# Runtime values for this generated build. Brand and architecture live in code.

# Application
# development is for localhost. production enables secure cookies and cached assets.
APP_ENV=development
APP_URL=http://localhost:8090
PORT=8090
# SUPPORT_EMAIL=hello@moin.run  # where people write; the default is moin's own
# Comma-separated operator addresses. Sign up with each address and verify it before accessing the Admin panel.
# They may always sign up, also while sign-up is closed. On a self-hosted control plane, put your own address
# here: without one, nobody can create the first account.
ADMIN_EMAILS=operator@example.com

# Database
DB_CONNECTION=./data/app.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)

# Session and token expiry
SESSION_EXPIRY=168h
TOKEN_EMAIL_VERIFY_EXPIRY=24h
TOKEN_PASSWORD_RESET_EXPIRY=1h
TOKEN_EMAIL_CHANGE_EXPIRY=24h
TOKEN_MAGIC_LINK_EXPIRY=10m

# Keep empty unless a reverse proxy reaches the app through a private network.
# Set it so auth rate limits use the visitor IP without trusting fake proxy headers.
# Trust only that exact network. Never use 0.0.0.0/0 or ::/0.
# Docker: docker network inspect YOUR_NETWORK --format '{{(index .IPAM.Config 0).Subnet}}'
TRUSTED_PROXY_CIDRS=
# Old domains of this control plane, comma-separated, like https://old.example.com.
# It still answers there: browsers go on to APP_URL, agents and the CLI move by themselves,
# and admins see under Admin, Old domain, what still arrives. Keep empty without one.
OLD_URLS=

# JSON API
# Comma-separated browser origins that may call /api/ with cookies or a bearer token,
# for example https://app.example.com,http://localhost:5173. Exact matches only, no wildcards.
# Keep empty when the frontend is served from APP_URL or the clients are native apps.
CORS_ALLOWED_ORIGINS=

# Public URL of this server for OAuth callbacks. Keep empty to use APP_URL.
API_URL=
# GitHub OAuth. Callback: {API_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The moin GitHub App, which connects repos. Create it on GitHub with
# Contents: read and Commit statuses: read and write, events Push and
# Installation. Callback URL: {APP_URL}/app/github/setup, with "Request
# user authorization (OAuth) during installation" and "Redirect on update"
# ticked; webhook URL:
# {APP_URL}/webhooks/github. The private key may use \n for newlines.
# Without GITHUB_APP_ID the control plane runs without GitHub.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Or the path of the key file, which keeps its line breaks.
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_WEBHOOK_SECRET=
# The app's client ID and a client secret, from its settings page. moin
# uses them to ask GitHub who installed the app, so nobody can connect
# another account's installation. Without them moin warns at startup.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Email goes through Cloudflare Email Sending. EMAIL_FROM must be on a domain
# set up for sending in Cloudflare. Without the account ID and token in
# development, emails are written to the log instead.
EMAIL_FROM=noreply@example.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Seals app env vars. 32 bytes in base64: openssl rand -base64 32
# Required outside development. Changing it makes stored env vars unreadable.
SECRETS_KEY=

# Payments. BILLING=false runs a self-hosted control plane: no Stripe, no
# prices, every workspace gets everything.
BILLING=true
# A self-hosted control plane sends a few anonymous counts every five minutes:
# instance ID, version, servers, apps, deploys. TELEMETRY=false turns it off.
TELEMETRY=true
# A self-hosted control plane asks GitHub once a day for the newest release
# and tells its admins when an update is out. UPDATE_CHECK=false turns it off.
UPDATE_CHECK=true
# true when the control plane runs on the same server as its apps, as
# install.sh sets it up: the agent's proxy serves it, and starts on the
# server's first connect.
SAME_SERVER=false
# false closes sign-up: new accounts only for ADMIN_EMAILS and invited people,
# others see "ask its admin for an invitation". A self-hosted control plane
# (BILLING=false) is closed by default.
# Default: true with billing, false without.
# SIGNUPS_OPEN=true
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
STRIPE_PRICE_ID_PRO_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_PRO_YEARLY=price_xxxxxxxxxxxxx
# S3-compatible storage. Cloudflare R2 and AWS S3 are supported. Development
# gets its own bucket, named <app>-development, with a key for that bucket
# only; production gets <app>-production. For R2:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto.
S3_REGION=auto
S3_BUCKET=moin-development
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
# Every change of the control plane's own database goes to this bucket too,
# and a server without a database restores it from there on start. On by
# default in production.
# BACKUP_DATABASE=true
# Every domain of every live app is checked once a minute, like a visitor.
# On by default in production; off in development, so no real domain gets
# called. UPTIME_CHECKS=true turns them on.
# UPTIME_CHECKS=false
# S3_PRESIGN_EXPIRY_PUBLIC=168h
# S3_PRESIGN_EXPIRY_PRIVATE=1h

# Optional analytics and error tracking
UMAMI_WEBSITE_ID=
UMAMI_HOST=cloud.umami.is
PLAUSIBLE_DOMAIN=
PLAUSIBLE_HOST=plausible.io
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=

# Prevent indexing on staging or private preview deployments.
# Default: false with billing, true on a self-hosted control plane.
# ROBOTS_NOINDEX=false

# Logging
LOG_LEVEL=
LOG_FORMAT=pretty
LOG_HTTP=true
