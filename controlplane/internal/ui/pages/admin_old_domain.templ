package pages

import (
	"strconv"
	"strings"

	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
)

// AdminOldDomain shows what still arrives on the old domains of the
// control plane, so the operator knows when one can go.
templ AdminOldDomain(report *model.OldDomain) {
	@layouts.Admin("Old domain · Admin") {
		@panelPage() {
			@kit.Header(kit.Back{Label: "Admin", Href: "/admin"}, "Old domain")
			if len(report.Hosts) == 0 {
				@kit.List() {
					@kit.Row("") {
						@kit.RowText("No old domain is set", "Put it in OLD_URLS.")
					}
				}
			} else {
				@kit.List() {
					@adminFact("Domain", strings.Join(report.Hosts, ", "))
					@adminFact("Can it go?", oldDomainVerdict(report))
					@adminFact("Requests", strconv.Itoa(report.Total)+" in "+strconv.Itoa(report.Days)+" days")
					@adminFact("Last request", oldDomainLast(report))
				}
				if len(report.Rows) > 0 {
					@kit.Section("By day", nil) {
						@kit.List() {
							for _, row := range report.Rows {
								@kit.Row("") {
									<div class="min-w-0 flex-1">
										<div class="truncate font-medium tabular-nums">{ row.Day }</div>
										<div class="truncate text-sm text-muted-foreground"><span class="font-mono">{ row.Host }</span> · { row.Kind }</div>
									</div>
									<span class="shrink-0 text-sm text-muted-foreground tabular-nums">{ strconv.Itoa(row.Requests) }</span>
								}
							}
						}
					}
				}
			}
		}
	}
}

func oldDomainLast(report *model.OldDomain) string {
	if report.LastAt == nil {
		return "None"
	}
	return report.LastAt.UTC().Format("Jan 2, 15:04 UTC")
}

// oldDomainVerdict is whether the old domain can go: after so many quiet
// days.
func oldDomainVerdict(report *model.OldDomain) string {
	if report.Quiet {
		return "Yes"
	}
	return "Not yet, after " + strconv.Itoa(report.QuietDays) + " quiet days"
}
