package pages

import (
	"fmt"
	"strconv"
	"time"

	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/service"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
	"github.com/axadrn/moin/internal/human"
)

// UptimeView is the uptime of an app's domains.
type UptimeView struct {
	App    model.App
	Uptime service.AppUptime
	Now    time.Time
}

// AppUptime is the uptime page, one step under the app's domains: per
// domain its state, the uptime over 24 hours, 7 and 30 days, the newest
// check, the last outages and the settings of its check.
templ AppUptime(view UptimeView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name }}
	@layouts.App(view.App.Name + " uptime") {
		@panelPage(templ.Attributes{"data-app-uptime": view.App.Name}) {
			@kit.Header(kit.Back{Label: "Domains", Href: appPath + "/domains"}, "Uptime")
			<div id="app-uptime" class="flex flex-col gap-6">
				@uptimeServerOffline(view)
				if len(view.Uptime.Domains) == 0 {
					@kit.Card("", nil) {
						@kit.Quiet() {
							No domain to check yet.
						}
						@kit.Command("moin domains add " + view.App.Name + ".example.com")
					}
				}
				for _, domain := range view.Uptime.Domains {
					@uptimeDomain(view, domain)
				}
			</div>
		}
	}
}

// AppUptimeBody is the uptime of each domain in a row, on the Domains
// section of an app; a row opens the uptime page.
templ AppUptimeBody(view UptimeView) {
	if len(view.Uptime.Domains) > 0 {
		@kit.Section("Uptime", nil) {
			@uptimeServerOffline(view)
			@kit.List() {
				for _, domain := range view.Uptime.Domains {
					@kit.Row(ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name + "/uptime") {
						@kit.RowText(domain.Domain, uptimeNote(domain))
						@uptimeState(domain)
					}
				}
			}
		}
	}
}

// uptimeServerOffline is the line that says the app's server is offline,
// so its checks say little.
templ uptimeServerOffline(view UptimeView) {
	if !view.Uptime.ServerOnline && view.App.ServerName != "" {
		<p class="px-1" data-server-offline>
			@kit.Status(kit.StateFailed, nil) {
				{ view.App.ServerName } is offline
			}
		</p>
	}
}

// uptimeDomain is one domain: its numbers and outages, then its check.
templ uptimeDomain(view UptimeView, domain service.UptimeDomain) {
	<div data-uptime-domain={ domain.Domain }>
		@kit.Section(domain.Domain, uptimeState(domain)) {
			<div class="flex flex-col gap-4">
				@kit.List() {
					@uptimeFact("Last 24 hours", orNone(percent(domain.Uptime24h)), averageNote(domain))
					@uptimeFact("Last 7 days", orNone(percent(domain.Uptime7d)), "")
					@uptimeFact("Last 30 days", orNone(percent(domain.Uptime30d)), "")
					@uptimeFact("Newest check", orNone(lastCheck(domain)), lastCheckNote(domain, view.Now))
					@uptimeFact("Certificate", certText(domain, view.Now), certNote(domain))
					if domain.Since != nil {
						@uptimeFact(sinceLabel(domain), sinceText(domain, view.Now), sinceNote(domain))
					}
					if len(domain.Outages) == 0 {
						@uptimeFact("Outages", "None in 90 days", "")
					}
				}
				if len(domain.Outages) > 0 {
					<div data-outages>
						@kit.List() {
							for _, outage := range domain.Outages {
								@kit.RowAttrs("", templ.Attributes{"data-outage": stamp(outage.StartedAt)}) {
									<div class="min-w-0 flex-1">
										<div class="font-medium tabular-nums" title={ stamp(outage.StartedAt) }>{ outage.StartedAt.UTC().Format("Jan 2, 15:04 UTC") }</div>
										<div class="text-sm text-muted-foreground">{ outageText(outage, view.Now) }</div>
									</div>
								}
							}
						}
					</div>
				}
				@uptimeSettings(view.App, domain)
			</div>
		}
	</div>
}

// uptimeFact is a row with a number on the right and what it means.
templ uptimeFact(label, value, note string) {
	@kit.RowFact(label, note) {
		{ value }
	}
}

// uptimeState is the state of a domain's check as a status.
templ uptimeState(domain service.UptimeDomain) {
	switch domain.State {
		case model.UptimeUp:
			@kit.Status(kit.StateLive, templ.Attributes{"data-uptime-state": domain.State}) {
				Up
			}
		case model.UptimeDown:
			@kit.Status(kit.StateFailed, templ.Attributes{"data-uptime-state": domain.State}) {
				Down
			}
		case model.UptimePaused:
			@kit.Status(kit.StateIdle, templ.Attributes{"data-uptime-state": domain.State}) {
				Paused
			}
		default:
			@kit.Status(kit.StateWaiting, templ.Attributes{"data-uptime-state": domain.State}) {
				Waiting
			}
	}
}

// uptimeSettings is the path of the check and the switch that pauses it.
templ uptimeSettings(app model.App, domain service.UptimeDomain) {
	{{ action := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name + "/uptime/check" }}
	{{ id := "uptime-" + domain.Domain }}
	@kit.List() {
		@kit.RowForm(templ.Attributes{"hx-post": action, "hx-target": "#app-uptime", "hx-select": "#app-uptime", "hx-swap": "outerHTML", "hx-disable": "find button[type='submit']", "data-uptime-path-form": domain.Domain}) {
			@kit.CSRF()
			<input type="hidden" name="domain" value={ domain.Domain }/>
			<div class="min-w-0 flex-1 pb-2">
				@kit.Field("Path", id+"-path", "") {
					@kit.Inline() {
						@kit.Input(templ.Attributes{"id": id + "-path", "name": "path", "type": "text", "value": customPath(domain), "placeholder": domain.Path, "autocomplete": "off", "autocapitalize": "off", "spellcheck": "false"})
						@kit.Button(kit.Secondary, "", templ.Attributes{"type": "submit"}) {
							Save
						}
					}
				}
			</div>
		}
		@UptimeSwitchForm(app, domain)
	}
}

// UptimeSwitchForm is the switch that pauses the check of a domain, a row
// that saves itself.
templ UptimeSwitchForm(app model.App, domain service.UptimeDomain) {
	{{ id := "uptime-" + domain.Domain }}
	@kit.RowForm(templ.Attributes{"id": id + "-form", "hx-post": ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name + "/uptime/on", "hx-trigger": "change", "hx-target": "this", "hx-swap": "outerHTML", "hx-disable": "find input[type='checkbox']"}) {
		@kit.CSRF()
		<input type="hidden" name="domain" value={ domain.Domain }/>
		@kit.RowLabel(id+"-on", "Check every minute", "")
		@kit.Switch(templ.Attributes{"id": id + "-on", "name": "on", "value": "1", "checked": !domain.Paused})
	}
}

// uptimeNote is the uptime of a domain in a few words, for its row.
func uptimeNote(domain service.UptimeDomain) string {
	if value := percent(domain.Uptime30d); value != "" {
		return value + " over 30 days"
	}
	return "No check yet"
}

func orNone(value string) string {
	if value == "" {
		return "None yet"
	}
	return value
}

func sinceLabel(domain service.UptimeDomain) string {
	switch domain.State {
	case model.UptimeUp:
		return "Up since"
	case model.UptimeDown:
		return "Down since"
	}
	return "Since"
}

func customPath(domain service.UptimeDomain) string {
	if domain.CustomPath {
		return domain.Path
	}
	return ""
}

func percent(value *float64) string {
	if value == nil {
		return ""
	}
	if *value == 100 {
		return "100%"
	}
	return strconv.FormatFloat(*value, 'f', 2, 64) + "%"
}

func averageNote(domain service.UptimeDomain) string {
	if domain.Uptime24h == nil {
		return ""
	}
	return fmt.Sprintf("%d ms on average", domain.AverageMS)
}

func lastCheck(domain service.UptimeDomain) string {
	switch {
	case domain.CheckedAt == nil:
		return ""
	case domain.StatusCode == 0:
		return "Failed"
	}
	return fmt.Sprintf("HTTP %d", domain.StatusCode)
}

func lastCheckNote(domain service.UptimeDomain, now time.Time) string {
	if domain.CheckedAt == nil {
		return ""
	}
	note := fmt.Sprintf("%d ms, %s", domain.ResponseMS, human.Ago(*domain.CheckedAt, now))
	if domain.Error != "" {
		note = domain.Error + ", " + human.Ago(*domain.CheckedAt, now)
	}
	return note
}

func certText(domain service.UptimeDomain, now time.Time) string {
	if domain.CertExpiresAt == nil {
		return "Not seen yet"
	}
	days := int(domain.CertExpiresAt.Sub(now).Hours() / 24)
	if days < 0 {
		return "Expired"
	}
	return fmt.Sprintf("Valid for %d days", days)
}

func certNote(domain service.UptimeDomain) string {
	if domain.CertExpiresAt == nil {
		return ""
	}
	return "Until " + domain.CertExpiresAt.UTC().Format("Jan 2, 2006")
}

func sinceText(domain service.UptimeDomain, now time.Time) string {
	if domain.Since == nil {
		return "Not yet"
	}
	return human.Ago(*domain.Since, now)
}

func sinceNote(domain service.UptimeDomain) string {
	if domain.Since == nil {
		return ""
	}
	return stamp(*domain.Since)
}

// outageText is how long an outage lasted, and why.
func outageText(outage model.UptimeOutage, now time.Time) string {
	end := now
	length := "ongoing for "
	if outage.EndedAt != nil {
		end, length = *outage.EndedAt, "down for "
	}
	text := length + human.Duration(end.Sub(outage.StartedAt))
	if outage.Reason != "" {
		text += " · " + outage.Reason
	}
	return text
}
