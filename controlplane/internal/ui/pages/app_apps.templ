package pages

import (
	"fmt"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"strconv"
	"strings"
	"time"

	"github.com/axadrn/moin/controlplane/internal/api"
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/ui/layouts"
	"github.com/axadrn/moin/protocol"
	"github.com/axadrn/moin/internal/human"
)

// Apps is every app of the workspace, in the one order: what needs you,
// what deploys, pinned apps, then by name.
templ Apps(apps []model.App, servers []model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("Apps") {
		@panelPage() {
			@kit.Header(kit.Back{Label: "Overview", Href: basePath + "/overview"}, "Apps") {
				<div class="sm:ml-auto">
					@kit.Button(kit.Primary, basePath+"/apps/new", nil) {
						New app
					}
				</div>
			}
			if len(apps) == 0 {
				@kit.List() {
					@kit.Row(basePath + "/apps/new") {
						@kit.RowText("No apps yet", "Start one from your folder, GitHub or the catalog.")
					}
				}
			} else {
				@appRows(apps, servers)
			}
		}
	}
}

// NewApp is where an app starts: from your folder, from GitHub, or from
// the catalog. Each is one card; the overview lists the apps.
templ NewApp(servers []model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@layouts.App("New app") {
		@panelPage() {
			@kit.Header(kit.Back{Label: "Apps", Href: basePath + "/apps"}, "New app")
			if len(servers) == 0 {
				@kit.List() {
					@kit.Row(basePath + "/servers") {
						@kit.RowText("Connect a server first", "Apps run on your servers. One command, no open port.")
					}
				}
			} else {
				@kit.Card("From your folder", nil) {
					@kit.Quiet() {
						Run this in the folder of your app. It finds compose.yml, a Dockerfile or a Go module and builds on your server.
					}
					@kit.Command("moin deploy")
				}
				@kit.Card("From GitHub", nil) {
					@kit.Quiet() {
						Name it and pick its server. Then link its repo, and every push deploys.
					}
					@AppAddForm(servers)
				}
				@kit.Card("From the catalog", nil) {
					@kit.Quiet() {
						Umami, n8n, Ghost and 44 more, the newest release in one click.
					}
					<div>
						@kit.Button(kit.Secondary, basePath+"/catalog", templ.Attributes{"data-catalog-link": true}) {
							Open the catalog
						}
					</div>
				}
			}
		}
	}
}

// AppAddForm names a new app and picks its server; the new app's page
// opens once it is added.
templ AppAddForm(servers []model.Server) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<form
		id="app-add-form"
		class="flex flex-col gap-2 sm:flex-row"
		hx-post={ basePath + "/apps" }
		hx-swap="none"
		hx-disable="find button[type='submit']"
	>
		@kit.CSRF()
		<label for="app-name" class="sr-only">App name</label>
		@kit.Input(templ.Attributes{"id": "app-name", "name": "name", "type": "text", "placeholder": "Name, like blog", "maxlength": "63", "autocomplete": "off", "spellcheck": "false", "data-hotkey-focus": true})
		<div class="flex gap-2 sm:w-64">
			@kit.Select(kit.SelectProps{ID: "app-server", Name: "server", Label: "Server", Options: serverOptions(servers)})
			@kit.Button(kit.Primary, "", templ.Attributes{"type": "submit"}) {
				Add
			}
		</div>
	</form>
}

func serverOptions(servers []model.Server) []kit.Option {
	options := make([]kit.Option, 0, len(servers))
	for _, server := range servers {
		options = append(options, kit.Option{Value: server.Name, Label: server.Name})
	}
	return options
}

func plural(n int, one, many string) string {
	if n == 1 {
		return "1 " + one
	}
	return strconv.Itoa(n) + " " + many
}

// panelHeadClasses is the head of a card on pages not yet on panel.
const panelHeadClasses = "flex min-h-14 items-center justify-between gap-3 px-5 pt-4 pb-1.5"

// AppPageView is an app and the section of it to show.
type AppPageView struct {
	App     model.App
	Deploys []api.Deploy
	EnvKeys []string
	// Section is app, deploys, domains, logs or settings; data has its
	// own page.
	Section string
	// Catalog is the update card of a catalog app (App section), Uptime the
	// checks of its domains (Domains): filled for the section that shows
	// them, so the page comes whole.
	Catalog *CatalogUpdateView
	Uptime  *UptimeView
	// Domains is the domains, instant address and password.
	Domains *DomainsView
	// Selected is the deploy whose log the Deploys section shows; 0 shows
	// the newest and follows the next one that starts.
	Selected int
	// Repo is the GitHub card of the Deploys section, as far as it is known
	// without asking GitHub.
	Repo *RepoView
	// Logs is the container logs of the Logs section; nil when the agent
	// did not answer in time, and the section loads them itself.
	Logs *AppLogsView
}

// AppPage is an app: the head stays, the section under it answers one
// question (appSections).
templ AppPage(view AppPageView) {
	{{ app := view.App }}
	@layouts.App(app.Name) {
		@panelPage(templ.Attributes{"data-app-page": app.Name}) {
			@appHeader(app, view.Section)
			@appSection(app.Name, view.Section) {
				switch view.Section {
					case "deploys":
						@appDeploysSection(app, view.Deploys, view.Selected, view.Selected == 0, view.Repo)
					case "domains":
						@appDomainsSection(view)
					case "logs":
						@appLogsSection(app, view.Deploys, view.Logs)
					case "settings":
						@appSettingsSection(app, view.EnvKeys)
					default:
						@appHomeSection(view)
				}
			}
		}
		// The app's changes come as the event "apps"; parts that show them
		// reload on it (hx-trigger "apps from:body").
		@kit.Live("/api/v1/apps/events?workspace=" + ctxkeys.Workspace(ctx).Slug)
	}
}

// appHomeSection answers "does it run?": the head says it; under it where
// the app is reached and how it does. On a phone it lists the sections
// first, each with what it holds, like a Settings page that drills down.
templ appHomeSection(view AppPageView) {
	{{ app := view.App }}
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name }}
	if view.Catalog != nil {
		@CatalogUpdate(*view.Catalog)
	}
	<div class="sm:hidden">
		@kit.List() {
			for _, section := range appSections[1:] {
				@kit.Row(appPath + section.Path) {
					@kit.RowText(section.Label, "")
					<span class="truncate text-sm text-muted-foreground">{ appSectionValue(app, view.Deploys, section.ID) }</span>
				}
			}
		}
	</div>
	<div class="hidden sm:block">
		@kit.Section("Domains", nil) {
			@kit.List() {
				for _, domain := range appDomains(app) {
					@kit.RowExternal("https://" + domain) {
						@kit.RowText(domain, "")
					}
				}
				if len(appDomains(app)) == 0 {
					@kit.RowControl(nil) {
						@kit.RowText("No domain yet", "")
						@kit.Button(kit.Secondary, appPath+"/domains", nil) {
							Add a domain
						}
					}
				}
			}
		}
	</div>
	@kit.List() {
		@kit.Row(appPath + "/metrics") {
			@kit.RowText("Metrics", "")
		}
		if app.Catalog != "" {
			// Its page in the catalog: what it is, its links, newer versions.
			@kit.Row(ctxkeys.AppBasePath(ctx) + "/catalog/" + app.Catalog) {
				@kit.RowText("In the catalog", app.Catalog)
			}
		}
	}
}

// appSectionValue is what a section holds, in a word, for the list on a
// phone.
func appSectionValue(app model.App, deploys []api.Deploy, id string) string {
	switch id {
	case "deploys":
		if len(deploys) == 0 {
			return "none yet"
		}
		return fmt.Sprintf("%d", len(deploys))
	case "domains":
		domains := appDomains(app)
		if len(domains) == 0 {
			return "none yet"
		}
		if len(domains) > 1 {
			return fmt.Sprintf("%s +%d", domains[0], len(domains)-1)
		}
		return domains[0]
	case "settings":
		if app.ChangesWaiting > 0 {
			return changesWaiting(app.ChangesWaiting)
		}
	}
	return ""
}

// appDomains are where the app answers: its domains, then its instant
// address.
func appDomains(app model.App) []string {
	domains := app.DomainList()
	if app.InstantHost != "" {
		domains = append(domains, app.InstantHost)
	}
	return domains
}

// appDeploysSection answers "how does code get in?": the versions, the log
// of the one picked, GitHub and CI.
templ appDeploysSection(app model.App, deploys []api.Deploy, selected int, follow bool, repo *RepoView) {
	<div class="grid items-stretch gap-4 lg:grid-cols-2">
		@appDeploys(app, deploys, selected, follow)
		@DeployLogPanel(app, selectedDeploy(deploys, selected), follow, false)
	</div>
	if repo != nil {
		@AppRepo(*repo)
	} else {
		@AppRepo(RepoView{App: app, Enabled: true, Connected: true, Loading: app.Repo == ""})
	}
	@appCI(app.Name, app.DeployHookHash != nil)
}

// appDomainsSection answers "where is it reached?": the instant address
// and the domains in one place, with the password and the uptime checks.
templ appDomainsSection(view AppPageView) {
	if view.Domains != nil {
		@AppDomains(*view.Domains)
	}
	if view.Uptime != nil {
		@AppUptimeBody(*view.Uptime)
	}
}

// appLogsSection answers "what happens in it?": the container logs, and a
// command to run in it. The logs come with the page; only when the agent is
// slow to answer they load into a box that keeps their place.
templ appLogsSection(app model.App, deploys []api.Deploy, logs *AppLogsView) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name }}
	@kit.Card("Last 200 lines", loadLogsButton(appPath)) {
		<div class="-mx-6">
			if logs != nil {
				@AppLogs(logs.Lines, logs.Message)
			} else {
				<div id="app-logs" hx-get={ appPath + "/logs/lines" } hx-trigger="load" hx-swap="outerHTML" class={ appLogsBox, "h-80 sm:h-[30rem]" }>
					<p class="px-6 text-sm text-muted-foreground">Reading the logs…</p>
				</div>
			}
		</div>
	}
	@appExec(app, deploys)
}

// AppLogsView is the container logs as the page shows them: the last lines,
// or why they could not be read.
type AppLogsView struct {
	Lines   []string
	Message string
}

// appLogsBox is the box of the container logs: the newest line at the
// bottom and in view (flex-col-reverse), few lines at the top.
const appLogsBox = "flex max-h-[30rem] flex-col-reverse justify-end-safe overflow-auto overscroll-contain outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset"

// appSettingsSection answers "how is it set up?": its env, the pin, and at
// the end what stops or removes it.
templ appSettingsSection(app model.App, envKeys []string) {
	{{ appPath := ctxkeys.AppBasePath(ctx) + "/apps/" + app.Name }}
	@AppEnv(app.Name, envKeys, nil)
	@kit.List() {
		@PinSwitch(app)
	}
	@kit.List() {
		if app.LiveNumber > 0 && !app.Stopped {
			@kit.RowButton(true, templ.Attributes{
				"hx-post":    appPath + "/stop",
				"hx-swap":    "none",
				"hx-disable": "this",
				"hx-confirm": "Stop " + app.Name + "? It is offline until you start it. Its data and settings stay.",
				"data-stop":  true,
			}) {
				<span class="font-medium">Stop { app.Name }</span>
			}
		}
		@kit.RowButton(true, templ.Attributes{
			"hx-delete":         appPath,
			"hx-swap":           "none",
			"hx-disable":        "this",
			"hx-confirm":        "Remove " + app.Name + "? Its containers stop and go. Its data stays on the server.",
			"data-confirm-name": app.Name,
			"data-remove-app":   true,
		}) {
			<span class="font-medium">Remove { app.Name }</span>
		}
	}
}

func appLiveLine(app model.App) string {
	switch {
	case app.LiveNumber == 0:
		return "Not deployed yet"
	case app.Stopped:
		return fmt.Sprintf("v%d, stopped", app.LiveNumber)
	}
	return fmt.Sprintf("v%d runs", app.LiveNumber)
}

func appLastDeployLine(deploys []api.Deploy) string {
	if len(deploys) == 0 {
		return "Deploy it with moin deploy"
	}
	return "Last deploy " + human.Ago(deploys[0].CreatedAt, time.Now())
}

templ loadLogsButton(appPath string) {
	@kit.Button(kit.Secondary, "", templ.Attributes{"hx-get": appPath + "/logs/lines", "hx-target": "#app-logs", "hx-swap": "outerHTML", "hx-disable": "this"}) {
		Reload
	}
}

// AppDetail is the state and the buttons of an app, for the reload on every
// change the app event stream reports. On the Deploys section (in empty) it
// brings the facts and the deploys too, and follows a running deploy.
templ AppDetail(app model.App, deploys []api.Deploy, selected int, follow bool, shown int, in string) {
	@appStateLine(app)
	@appActions(app)
	if in == "" || in == "deploys" {
		@appDeploys(app, deploys, selected, follow)
		// Following the newest deploy, a new one takes the log.
		if follow && len(deploys) > 0 && deploys[0].Number != shown {
			@DeployLogPanel(app, &deploys[0], true, true)
		}
	}
}

func failedCount(deploys []api.Deploy) int {
	n := 0
	for _, deploy := range deploys {
		if deploy.Status == model.DeployFailed {
			n++
		}
	}
	return n
}

func deployByNumber(deploys []api.Deploy, number int) (api.Deploy, bool) {
	for _, deploy := range deploys {
		if deploy.Number == number {
			return deploy, true
		}
	}
	return api.Deploy{}, false
}

// lastTook is how long the newest finished deploy took, and its number.
func lastTook(deploys []api.Deploy) (string, int) {
	for _, deploy := range deploys {
		if d := took(deploy.CreatedAt, deploy.FinishedAt); d != "" {
			return d, deploy.Number
		}
	}
	return "", 0
}

// appDeploys is the deploys, newest first: a list on a card, the one whose
// log shows lit. It reloads itself on every change of the app.
templ appDeploys(app model.App, deploys []api.Deploy, selected int, follow bool) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<section
		id="app-detail"
		hx-swap-oob="true"
		hx-get={ detailHref(basePath, app.Name, selected, follow, deploys) }
		hx-trigger="apps from:body"
		hx-swap="none"
		data-latest-number={ strconv.Itoa(app.LatestNumber) }
		data-latest-status={ app.LatestStatus }
		class="flex min-w-0 flex-col rounded-4xl bg-card p-1.5"
		aria-label="Deploys"
	>
		if len(deploys) == 0 {
			<div class="flex flex-col gap-3 px-5 py-4">
				<p class="font-medium">No deploys yet</p>
				@kit.Command("moin deploy " + app.Name)
			</div>
		} else {
			<div class="flex flex-col" role="list">
				for _, deploy := range deploys[:min(len(deploys), deploysShown)] {
					@deployRow(app, deploys, deploy, selected)
				}
				if len(deploys) > deploysShown {
					@kit.RowMore(plural(len(deploys)-deploysShown, "older deploy", "older deploys")) {
						for _, deploy := range deploys[deploysShown:] {
							@deployRow(app, deploys, deploy, selected)
						}
					}
				}
			</div>
		}
	</section>
}

// deployRow is one deploy: its version (a link to its log), state, commit
// and age. Roll back sits by the log of the deploy picked.
templ deployRow(app model.App, deploys []api.Deploy, deploy api.Deploy, selected int) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ now := time.Now() }}
	@kit.RowAttrs(deployHref(basePath, app.Name, deploys, deploy.Number), deployRowAttributes(deploy.Number, deploy.Number == selectedNumber(deploys, selected))) {
		<div class="flex min-w-0 flex-1 flex-col gap-0.5">
			<span class="flex min-w-0 items-center gap-3">
				<span class="font-semibold tabular-nums">{ fmt.Sprintf("v%d", deploy.Number) }</span>
				@deployStatus(deploy, app.LiveNumber)
				<span class="ml-auto text-sm whitespace-nowrap text-muted-foreground tabular-nums" title={ stamp(deploy.CreatedAt) }>
					{ human.Ago(deploy.CreatedAt, now) }
				</span>
			</span>
			if deploy.Commit != "" {
				<span class="truncate text-sm text-muted-foreground" title={ deploy.CommitMessage } data-deploy-commit>
					<span class="font-mono">{ shortCommit(deploy.Commit) }</span>
					{ deploy.CommitMessage }
				</span>
			}
			if deploy.FromNumber > 0 {
				<span class="text-sm text-muted-foreground">{ fmt.Sprintf("rollback to v%d", deploy.FromNumber) }</span>
			}
			if deploy.Error != "" {
				<span class="truncate text-sm text-failed" title={ deploy.Error }>{ deploy.Error }</span>
			}
		</div>
	}
}

// deployRowAttributes name a deploy's row; the one whose log shows is the
// current one, lit.
func deployRowAttributes(number int, current bool) templ.Attributes {
	attributes := templ.Attributes{"data-deploy": strconv.Itoa(number)}
	if current {
		attributes["aria-current"] = "true"
		attributes["data-selected"] = true
	}
	return attributes
}

// canRollBack is whether a deploy can run again: it succeeded, is not
// live, and nothing deploys right now.
func canRollBack(app model.App, deploy api.Deploy) bool {
	onServer := deploy.OnServer == nil || *deploy.OnServer
	return deploy.Status == model.DeploySucceeded && deploy.Number != app.LiveNumber && app.LatestStatus != model.DeployRunning && onServer
}

// deploysShown is how many deploys the list shows before "Show older".
const deploysShown = 8

// deployStatus is the state of one deploy, symbol and word.
templ deployStatus(deploy api.Deploy, liveNumber int) {
	switch  {
		case deploy.Status == model.DeployRunning:
			@kit.Status(kit.StateRunning, nil) {
				deploying
			}
		case deploy.Status == model.DeployFailed:
			@kit.Status(kit.StateFailed, nil) {
				failed
			}
		case deploy.Number == liveNumber:
			@kit.Status(kit.StateLive, nil) {
				live
			}
		default:
			@kit.Status(kit.StateDone, nil) {
				succeeded
			}
	}
}

// AppLogs shows the container logs, or why they could not be read, in the
// box the page kept for them.
templ AppLogs(lines []string, message string) {
	<div id="app-logs" class={ appLogsBox } tabindex="0" aria-label="Container logs">
		if message != "" {
			<p class="flex gap-2 px-6 text-sm text-failed"><span aria-hidden="true">✗</span>{ message }</p>
		} else if len(lines) == 0 {
			<p class="px-6 text-sm text-muted-foreground">No log lines yet.</p>
		} else {
			<div class="moin-term moin-term-lines">
				for _, line := range lines {
					{{ entry := parseLogLine(line) }}
					<div class="moin-term-line moin-term-log">
						if entry.Service != "" {
							<span class="moin-term-dim hidden sm:block" title={ entry.Time }>{ entry.Clock }</span>
							<span class="moin-term-dim hidden truncate pr-3 sm:block">{ entry.Service }</span>
						}
						<span class={ templ.KV("sm:col-span-3", entry.Service == "") }>{ entry.Message }</span>
					</div>
				}
			</div>
		}
	</div>
}

// logLine is one line of docker compose logs --timestamps:
// "web-1  | 2026-10-31T10:31:30.123456789Z message".
type logLine struct {
	Service string
	Time    string
	Clock   string
	Message string
}

func parseLogLine(line string) logLine {
	service, rest, found := strings.Cut(line, " | ")
	service = strings.TrimSpace(service)
	if !found || service == "" || strings.Contains(service, " ") {
		return logLine{Message: line}
	}
	entry := logLine{Service: service, Message: rest}
	if stampText, message, ok := strings.Cut(rest, " "); ok {
		if t, err := time.Parse(time.RFC3339Nano, stampText); err == nil {
			entry.Time = stamp(t)
			entry.Clock = t.UTC().Format("15:04:05")
			entry.Message = message
		}
	}
	return entry
}

// AppEnv is the env vars of an app, one row each, and the row that sets
// one. values holds the shown values; keys without one show as dots. Saving
// never restarts the app: the head then says what waits for Restart.
templ AppEnv(appName string, keys []string, values map[string]string) {
	{{ envPath := ctxkeys.AppBasePath(ctx) + "/apps/" + appName + "/env" }}
	<div id="app-env">
		@kit.Section("Environment", envModes(appName, false)) {
			@kit.List() {
				if len(keys) == 0 {
					@kit.Row("") {
						@kit.RowText("No env vars yet", "")
					}
				}
				for _, key := range keys {
					@kit.RowControl(nil) {
						<span data-env={ key } class="max-w-[55%] shrink-0 truncate font-mono text-sm" title={ key }>{ key }</span>
						<span class="min-w-0 flex-1 truncate text-right font-mono text-sm text-muted-foreground">
							if value, ok := values[key]; ok {
								<span data-env-value class="text-foreground">{ value }</span>
							} else {
								<span aria-label="hidden">••••••</span>
							}
						</span>
						<button
							type="button"
							aria-label={ "Remove " + key }
							title={ "Remove " + key }
							hx-delete={ envPath + "/" + key }
							hx-target="#app-env"
							hx-swap="outerHTML"
							hx-disable="this"
							hx-confirm={ "Remove " + key + "? The next deploy or restart drops it." }
							data-confirm-action="Remove"
							class="-my-1.5 -mr-3.5 flex size-11 shrink-0 items-center justify-center rounded-full text-muted-foreground outline-none hover:bg-foreground/5 hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/30"
						>
							@kit.IconX("size-4")
						</button>
					}
				}
				if len(keys) > 0 {
					if len(values) == 0 {
						@kit.RowButton(false, templ.Attributes{"hx-get": envPath + "?show=1", "hx-target": "#app-env", "hx-swap": "outerHTML", "data-env-show": true}) {
							<span class="font-medium">Show values</span>
						}
					} else {
						@kit.RowButton(false, templ.Attributes{"hx-get": envPath, "hx-target": "#app-env", "hx-swap": "outerHTML", "data-env-hide": true}) {
							<span class="font-medium">Hide values</span>
						}
					}
				}
				@kit.RowForm(templ.Attributes{"hx-post": envPath, "hx-target": "#app-env", "hx-swap": "outerHTML", "hx-disable": "find button[type='submit']", "data-env-set": true}) {
					<div class="flex min-w-0 flex-1 flex-col gap-2 sm:flex-row">
						@kit.CSRF()
						<label for="env-key" class="sr-only">Name</label>
						<div class="sm:w-56 sm:shrink-0">
							@kit.Input(templ.Attributes{"id": "env-key", "name": "key", "type": "text", "placeholder": "Name", "autocomplete": "off", "autocapitalize": "characters", "spellcheck": "false", "required": true})
						</div>
						<label for="env-value" class="sr-only">Value</label>
						@kit.Input(templ.Attributes{"id": "env-value", "name": "value", "type": "password", "placeholder": "Value", "autocomplete": "off"})
						@kit.Button(kit.Primary, "", templ.Attributes{"type": "submit"}) {
							Set
						}
					</div>
				}
			}
		}
	</div>
}

// shortPath keeps the last three parts of a long path: …/volumes/data/app.db.
func shortPath(path string) string {
	parts := strings.Split(strings.Trim(path, "/"), "/")
	if len(parts) <= 3 {
		return path
	}
	return "…/" + strings.Join(parts[len(parts)-3:], "/")
}

func liveDetected(deploys []api.Deploy) *protocol.Detected {
	for _, deploy := range deploys {
		if deploy.Status == model.DeploySucceeded && deploy.Detected != nil {
			return deploy.Detected
		}
	}
	return nil
}

func shortCommit(sha string) string {
	if len(sha) > 7 {
		return sha[:7]
	}
	return sha
}
