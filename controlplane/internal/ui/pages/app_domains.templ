package pages

import (
	"github.com/axadrn/moin/controlplane/internal/ctxkeys"
	"github.com/axadrn/moin/controlplane/internal/model"
	"github.com/axadrn/moin/controlplane/internal/service"
	"github.com/axadrn/moin/controlplane/internal/ui/kit"
	"github.com/axadrn/moin/protocol"
	"strings"
)

// DomainsView is what the Domains section shows.
type DomainsView struct {
	App model.App
	// Checks are the domains; only one added or checked was looked up
	// (Checked), opening the page looks up none.
	Checks []service.DomainCheck
	// Server runs the app.
	Server  model.Server
	Instant service.Instant
}

// AppDomains is where an app is reached: its domains, the instant address
// and the password in front of it. A domain says whether it points at the
// server once it was added or checked; opening the page waits on no DNS.
templ AppDomains(view DomainsView) {
	{{ domainsPath := ctxkeys.AppBasePath(ctx) + "/apps/" + view.App.Name + "/domains" }}
	<div id="app-domains" class="flex flex-col gap-6">
		@kit.Section("Domains", nil) {
			@kit.List() {
				for _, check := range view.Checks {
					@domainRow(check, view.App.Name, domainsPath)
				}
				if options := canonicalOptions(view.Checks); len(options) > 2 && !fromCompose(view.Checks) {
					@canonicalRow(options, view.App.Canonical, domainsPath)
				}
				if fromCompose(view.Checks) {
					@kit.RowAttrs("", templ.Attributes{"data-domains-from-compose": true}) {
						<p class="min-w-0 flex-1 text-sm text-muted-foreground">Change them in compose.yml (<span class="font-mono">x-moin.domains</span>) and deploy.</p>
					}
				} else {
					@addDomainRow(domainsPath)
				}
			}
		}
		@instantSection(view, domainsPath)
		@passwordSection(view.App, domainsPath)
	</div>
}

// canonicalRow picks the domain the others redirect to; it saves itself.
templ canonicalRow(options []kit.Option, canonical, domainsPath string) {
	@kit.RowForm(templ.Attributes{"hx-post": domainsPath + "/canonical", "hx-trigger": "change", "hx-target": "#app-domains", "hx-swap": "outerHTML", "data-canonical": true}) {
		@kit.CSRF()
		@kit.RowLabel("canonical-domain", "Canonical", "")
		<div class="w-44 shrink-0 sm:w-64">
			@kit.Select(kit.SelectProps{ID: "canonical-domain", Name: "domain", Label: "Canonical domain", Options: options, Value: canonical})
		</div>
	}
}

// domainRow is one domain: its name, a quiet word for what it is
// (canonical, a service, from compose.yml), what its DNS says once checked,
// and its actions. On a phone the actions go under the name when they do
// not fit next to it.
templ domainRow(check service.DomainCheck, appName, domainsPath string) {
	@kit.RowControl(templ.Attributes{"data-domain": check.Domain}) {
		<div class="min-w-36 flex-1">
			<a href={ templ.SafeURL("https://" + check.Domain) } target="_blank" rel="noopener" class="block truncate font-medium underline-offset-4 hover:underline">{ check.Domain }</a>
			if note := domainNote(check); note != "" {
				<div
					class="truncate text-sm text-muted-foreground"
					if check.Service != "" {
						data-domain-service={ check.Service }
					}
				>{ note }</div>
			}
			if check.Checked {
				<div class="mt-1" data-domain-checked>
					if check.Points {
						@kit.Status(kit.StateLive, nil) {
							Points here
						}
					} else {
						@kit.Status(kit.StateWaiting, nil) {
							Set its { check.Advice }
						}
					}
				</div>
			}
		</div>
		<div class="flex items-center gap-2">
			@kit.Button(kit.Secondary, "", templ.Attributes{
				"hx-get":     domainsPath + "/detail?check=" + check.Domain,
				"hx-target":  "#app-domains",
				"hx-swap":    "outerHTML",
				"hx-disable": "this",
				"aria-label": "Check the DNS of " + check.Domain,
				"data-check": check.Domain,
			}) {
				Check
			}
			if !check.FromCompose {
				<button
					type="button"
					aria-label={ "Remove " + check.Domain }
					title={ "Remove " + check.Domain }
					hx-post={ domainsPath + "/remove" }
					hx-vals={ `{"domain": "` + check.Domain + `", "service": "` + check.Service + `"}` }
					hx-target="#app-domains"
					hx-swap="outerHTML"
					hx-disable="this"
					hx-confirm={ "Remove " + check.Domain + "? " + appName + " stops answering on it at the next restart." }
					data-confirm-action="Remove"
					class="flex size-11 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground outline-none hover:text-failed focus-visible:ring-3 focus-visible:ring-ring/30 disabled:opacity-40"
				>
					<svg aria-hidden="true" viewBox="0 0 16 16" class="size-4"><path d="M4.5 4.5l7 7m0-7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
				</button>
			}
		</div>
	}
}

// addDomainRow is the field that adds a domain, to the main service or to
// another service of compose.yml.
templ addDomainRow(domainsPath string) {
	@kit.RowForm(templ.Attributes{"hx-post": domainsPath + "/add", "hx-target": "#app-domains", "hx-swap": "outerHTML", "hx-disable": "find button[type='submit']"}) {
		@kit.CSRF()
		<div class="min-w-0 flex-1 pb-2">
			@kit.Field("Add a domain", "domain-name", "") {
				@kit.Inline() {
					@kit.Input(templ.Attributes{"id": "domain-name", "name": "domain", "type": "text", "placeholder": "shop.example.com", "autocomplete": "off", "autocapitalize": "off", "spellcheck": "false", "required": true})
					<label for="domain-service" class="sr-only">Service, empty for the main one</label>
					<div class="sm:w-40 sm:shrink-0">
						@kit.Input(templ.Attributes{"id": "domain-service", "name": "service", "type": "text", "placeholder": "service", "autocomplete": "off", "autocapitalize": "off", "spellcheck": "false", "title": "A service of compose.yml other than the main one, such as api"})
					</div>
					@kit.Button(kit.Secondary, "", templ.Attributes{"type": "submit", "data-add-domain": true}) {
						Add
					}
				}
			}
		</div>
	}
}

// instantSection is the instant address: a switch, where it is or why the
// app has none, its provider and its password.
templ instantSection(view DomainsView, domainsPath string) {
	{{ instant := view.Instant }}
	{{ on := instant.Provider != "" && instant.Provider != "off" }}
	@kit.Section("Instant address", nil) {
		<div data-instant>
			@kit.List() {
				@kit.RowForm(templ.Attributes{"hx-post": domainsPath + "/instant", "hx-trigger": "change", "hx-target": "#app-domains", "hx-swap": "outerHTML", "hx-disable": "find input[type='checkbox']"}) {
					@kit.CSRF()
					<input type="hidden" name="switch" value="1"/>
					<div class="min-w-0 flex-1">
						if instant.URL != "" {
							<a href={ templ.SafeURL(instant.URL) } target="_blank" rel="noopener" class="block truncate font-medium underline-offset-4 hover:underline" data-instant-url>{ instant.Host }</a>
						} else if on {
							<div class="text-sm text-muted-foreground" data-instant-reason>{ instant.Reason }</div>
						} else {
							<div class="font-medium text-muted-foreground" data-instant-reason>Off</div>
						}
					</div>
					@kit.Switch(templ.Attributes{"id": "instant-on", "name": "on", "value": "1", "checked": on, "aria-label": "Instant address", "data-instant-switch": true})
				}
				if on {
					@kit.RowForm(templ.Attributes{"hx-post": domainsPath + "/instant", "hx-trigger": "change", "hx-target": "#app-domains", "hx-swap": "outerHTML", "data-instant-provider": true}) {
						@kit.CSRF()
						@kit.RowLabel("instant-provider", "Provider", "")
						<div class="w-36 shrink-0">
							@kit.Select(kit.SelectProps{ID: "instant-provider", Name: "provider", Label: "Provider", Options: instantOptions(), Value: instant.Provider})
						</div>
					}
					if instant.URL != "" {
						@kit.RowForm(templ.Attributes{"hx-post": domainsPath + "/instant-password", "hx-trigger": "change", "hx-target": "#app-domains", "hx-swap": "outerHTML", "hx-disable": "find input[type='checkbox']"}) {
							@kit.CSRF()
							<input type="hidden" name="password" value="1"/>
							@kit.RowLabel("instant-password-on", "Password", instantSignIn(instant))
							@kit.Switch(templ.Attributes{"id": "instant-password-on", "name": "on", "value": "1", "checked": !instant.Open})
						}
						if !instant.Open && !instant.OwnPassword {
							if instant.Password != "" {
								@kit.Row("") {
									<span class="min-w-0 flex-1 truncate font-mono text-sm select-all" data-instant-password>{ instant.Password }</span>
								}
							} else {
								@kit.RowButton(false, templ.Attributes{"hx-get": domainsPath + "/detail?show=true", "hx-target": "#app-domains", "hx-swap": "outerHTML", "hx-disable": "this", "data-instant-show": true}) {
									<span class="font-medium">Show password</span>
								}
							}
						}
					}
				}
			}
		</div>
	}
}

// passwordSection is the password in front of the app: off, a switch
// opens its fields; on, who signs in and Remove.
templ passwordSection(app model.App, domainsPath string) {
	@kit.Section("Password", nil) {
		if app.Protect != "" {
			@kit.List() {
				@kit.Row("") {
					@kit.RowText("Sign in as "+protectUser(app), "")
					<span class="text-sm text-muted-foreground" data-protected>On</span>
				}
				@kit.RowButton(true, templ.Attributes{
					"hx-post":        domainsPath + "/unprotect",
					"hx-target":      "#app-domains",
					"hx-swap":        "outerHTML",
					"hx-disable":     "this",
					"hx-confirm":     "Remove the password? Anyone with the link can open " + app.Name + " after the next restart.",
					"data-unprotect": true,
				}) {
					<span class="font-medium">Remove password</span>
				}
			}
		} else {
			@kit.List() {
				@kit.RowMore("Ask for a password") {
					@kit.RowForm(templ.Attributes{"id": "protect-form", "hx-post": domainsPath + "/protect", "hx-target": "#app-domains", "hx-swap": "outerHTML", "hx-disable": "find button[type='submit']"}) {
						@kit.CSRF()
						<div class="flex min-w-0 flex-1 flex-col gap-4 pt-1 pb-2">
							<div class="grid gap-4 sm:grid-cols-2">
								@kit.Field("Username", "protect-user", "") {
									@kit.Input(templ.Attributes{"id": "protect-user", "name": "username", "type": "text", "value": "moin", "autocomplete": "off", "autocapitalize": "off", "spellcheck": "false", "required": true})
								}
								@kit.Field("Password", "protect-password", "") {
									@kit.Input(templ.Attributes{"id": "protect-password", "name": "password", "type": "password", "autocomplete": "new-password", "required": true, "minlength": "8", "maxlength": "72", "placeholder": "8 to 72 characters"})
								}
							</div>
							<div class="flex justify-end">
								@kit.Button(kit.Secondary, "", templ.Attributes{"type": "submit", "data-protect": true}) {
									Set password
								}
							</div>
						</div>
					}
				}
			}
		}
	}
}

// instantOptions are the providers of the instant address.
func instantOptions() []kit.Option {
	options := []kit.Option{}
	for _, provider := range protocol.InstantProviders {
		options = append(options, kit.Option{Value: provider, Label: provider})
	}
	return options
}

// instantSignIn is who signs in on the instant address, and with what.
func instantSignIn(instant service.Instant) string {
	switch {
	case instant.Open:
		return ""
	case instant.OwnPassword:
		return "Sign in as " + instant.User + " with the app's password"
	}
	return "Sign in as " + instant.User
}

// domainNote is the quiet words under a domain: canonical, its service,
// from compose.yml.
func domainNote(check service.DomainCheck) string {
	var words []string
	if check.Canonical {
		words = append(words, "canonical")
	}
	if check.Service != "" {
		words = append(words, "service "+check.Service)
	}
	if check.FromCompose {
		words = append(words, "from compose.yml")
	}
	return strings.Join(words, " · ")
}

// canonicalOptions are the domains of the main service one can be the
// canonical of, and none.
func canonicalOptions(checks []service.DomainCheck) []kit.Option {
	options := []kit.Option{{Value: "", Label: "None"}}
	for _, check := range checks {
		if check.Service == "" {
			options = append(options, kit.Option{Value: check.Domain, Label: check.Domain})
		}
	}
	return options
}

// fromCompose says x-moin.domains in compose.yml sets the domains of the
// main service.
func fromCompose(checks []service.DomainCheck) bool {
	return len(checks) > 0 && checks[0].FromCompose && checks[0].Service == ""
}

func orDash(value string) string {
	if value == "" {
		return "-"
	}
	return value
}

func protectUser(app model.App) string {
	for index, char := range app.Protect {
		if char == ':' {
			return app.Protect[:index]
		}
	}
	return "moin"
}
